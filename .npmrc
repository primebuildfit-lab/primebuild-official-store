# pnpm configuration for PrimeBuild Official Store.
# This machine blocks package install scripts by default, which silently breaks
# native binaries (esbuild, tailwind oxide, sharp). We explicitly allow builds
# only for the vetted native dependencies via pnpm.onlyBuiltDependencies in
# package.json.

auto-install-peers=true
strict-peer-dependencies=false
prefer-workspace-packages=true

# Flat node_modules (no symlink farm). Required for Next.js `output: standalone`
# desktop packaging on Windows: the isolated (symlinked) layout makes Next's
# standalone step attempt privileged symlinks (EPERM) on non-admin accounts.
# A hoisted layout lets standalone copy real files. Behaviour is unchanged for
# the web app.
node-linker=hoisted
