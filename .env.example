# PrimeBuild Official Store — environment template
# Copy to `.env` and fill in. NEVER commit real secrets.

# ── Official Store (Shopify, read-only) ──────────────────────────────────────
# Connects PrimeBuild Official Store to the live primebuildfit storefront.
# Without these, every screen shows an honest "store not connected" state.
# The token MUST be a READ-ONLY Admin API access token — this console never
# writes to the store.
# SHOPIFY_STORE_DOMAIN="primebuildfit.myshopify.com"
# SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SHOPIFY_API_VERSION="2025-01"
